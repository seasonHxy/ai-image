# 管理后台密钥（请修改为强随机字符串）
ADMIN_KEY=change-me-to-a-strong-random-string

# 站点 URL（用于 SEO sitemap/robots）
SITE_URL=http://localhost:3000

# 邮件服务（可选，不配置则验证码以 demoCode 返回）
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 图片生成 API（可选，默认使用 Pollinations.ai 免费服务）
# 如需使用其他服务，可在此配置
IMAGE_API_URL=
IMAGE_API_KEY=
